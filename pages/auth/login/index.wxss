.login-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f1f4f6;
  box-sizing: border-box;
}

.login-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
}

.brand-illustration {
  width: 632rpx;
}

.login-form {
  flex: 1;
  padding: 40rpx 48rpx 96rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.login-form--secondary {
  padding-top: 32rpx;
}

.auth-tip {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  color: #7b8591;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.auth-tip__icon {
  width: 28rpx;
  height: 28rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
}

.auth-tip__text {
  flex: 1;
}

.field-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.field-heading {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.login-page .field-label {
  display: block;
  margin-bottom: 0;
  font-size: 28rpx;
  line-height: 44rpx;
  color: #1b2129;
  font-weight: 400;
}

.login-input {
  width: 100%;
  height: 84rpx;
  padding: 0 32rpx;
  border: none;
  border-radius: 16rpx;
  background: #ffffff;
  font-size: 28rpx;
  line-height: 44rpx;
  color: #1b2129;
  box-sizing: border-box;
  font-weight: 400;
}

.login-input--readonly {
  display: flex;
  align-items: center;
  color: #626c78;
  background: #e9edf0;
}

.login-placeholder {
  color: #c4c9cf;
  font-size: 28rpx;
}

.login-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
}

.info-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.login-about-text {
  font-size: 28rpx;
  line-height: 44rpx;
  color: #1b2129;
}

.auth-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding-top: 8rpx;
}

.auth-text-link {
  color: #246fe5;
  font-size: 26rpx;
  line-height: 40rpx;
}

.auth-links__divider {
  width: 2rpx;
  height: 24rpx;
  background: #d5dbe0;
}

.legacy-entry {
  color: #7b8591;
  font-size: 24rpx;
  line-height: 40rpx;
  text-align: center;
}

.reset-methods {
  display: flex;
  padding: 8rpx;
  border-radius: 16rpx;
  background: #e7ebee;
}

.reset-method {
  flex: 1;
  padding: 18rpx 12rpx;
  border-radius: 12rpx;
  color: #7b8591;
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
}

.reset-method--active {
  color: #246fe5;
  background: #ffffff;
  font-weight: 600;
}

.wechat-account-card {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.wechat-account-card__label {
  color: #7b8591;
  font-size: 24rpx;
  line-height: 40rpx;
}

.wechat-account-card__value {
  color: #1b2129;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 44rpx;
  word-break: break-all;
}

.wechat-account-card__value--muted {
  color: #8b949e;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.recovery-notice,
.recovered-account-card {
  padding: 28rpx 32rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.recovery-notice__title {
  color: #1b2129;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.recovery-notice__text {
  margin-top: 8rpx;
  color: #7b8591;
  font-size: 24rpx;
  line-height: 40rpx;
}

.recovered-account-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.recovered-account-card__label {
  color: #7b8591;
  font-size: 24rpx;
}

.recovered-account-card__value {
  color: #1b2129;
  font-size: 40rpx;
  font-weight: 600;
}

.recovery-dialog {
  position: fixed;
  inset: 0;
  z-index: 11000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.recovery-dialog__mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.62);
}

.recovery-dialog__panel {
  position: relative;
  width: 100%;
  padding: 40rpx 32rpx 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.recovery-dialog__title {
  color: #1b2129;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 52rpx;
  text-align: center;
}

.recovery-dialog__tip {
  margin-top: 16rpx;
  color: #7b8591;
  font-size: 24rpx;
  line-height: 40rpx;
}

.recovery-dialog__account {
  margin-top: 24rpx;
  color: #626c78;
  font-size: 26rpx;
  text-align: center;
}

.recovery-dialog__code {
  margin-top: 20rpx;
  padding: 24rpx 12rpx;
  border-radius: 14rpx;
  background: #f1f4f6;
  color: #1b2129;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 44rpx;
  text-align: center;
  word-break: break-all;
}

.recovery-dialog__copy {
  padding: 20rpx 0 28rpx;
  color: #246fe5;
  font-size: 26rpx;
  text-align: center;
}

/* ================================================================
   关于家物小记 - 底部弹出面板
   ================================================================ */

/* ---- 遮罩层 ---- */
.about-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(0, 0, 0, 0);
  transition: background 0.3s ease;
}

.about-mask--show {
  background: rgba(0, 0, 0, 0.7);
}

/* ---- 面板容器 ---- */
.about-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  /* Figma: 面板顶部留 96px 空间，面板占剩余高度 */
  top: 192rpx;
  background: #f7f9fa;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  /* 初始态：隐藏在屏幕底部 */
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.about-panel--show {
  transform: translateY(0);
}

/* ---- 导航栏 ---- */
.about-navbar {
  display: flex;
  align-items: center;
  height: 92rpx;
  flex-shrink: 0;
}

.about-navbar__left {
  width: 156rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  padding-left: 32rpx;
  box-sizing: border-box;
}

.about-close-icon {
  width: 44rpx;
  height: 44rpx;
}

.about-navbar__title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 48rpx;
  color: #1b2129;
}

.about-navbar__right {
  width: 156rpx;
  height: 92rpx;
}

/* ---- 内容区（scroll-view 需要明确高度） ---- */
.about-scroll {
  flex: 1;
  height: 0;
  padding: 32rpx 48rpx 0;
  box-sizing: border-box;
}

/* 视频 Banner */
.about-video-wrap {
  position: relative;
  width: 100%;
  height: 436rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.about-video {
  width: 100%;
  height: 100%;
}

.about-video-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.about-video-overlay__button {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
}

.about-video-overlay__triangle {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
  border-left: 26rpx solid #ffffff;
}

/* 介绍文字 */
.about-text {
  padding: 32rpx 0 80rpx;
  word-wrap: break-word;
  word-break: break-all;
}

.about-text text {
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.57;
  color: #626C78;
}
